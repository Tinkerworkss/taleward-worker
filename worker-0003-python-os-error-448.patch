+            messordner: Path | None = None) -> None:
         if self._abbrechen.is_set():
             raise MotorFehler("abgebrochen")
         befehl = [uv_programm(), *argumente]
         self.zeilen.append("$ uv " + " ".join(argumente))
-        cache = pfade.basis() / "cache"
